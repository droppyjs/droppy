{
    "name": "@droppyjs/cli",
    "version": "2.0.0-alpha.4",
    "description": "> Command Line Interface for droppy.",
    "author": "droppyjs <hello@droppyjs.com>",
    "homepage": "https://github.com/droppyjs/droppy#readme",
    "license": "BSD-2-Clause",
    "main": "dist/cli.js",
    "types": "dist/cli.d.ts",
    "type": "module",
    "dependencies": {
        "@droppyjs/server": "workspace:^",
        "daemonize-process": "4.1.1",
        "minimist": "^1.2.8",
        "ps-node": "^0.1.6",
        "untildify": "^6.0.0",
        "which": "^6.0.0"
    },
    "directories": {
        "src": "src",
        "test": "__tests__",
        "dist": "dist"
    },
    "files": [
        "bin",
        "dist"
    ],
    "keywords": [
        "self-hosted",
        "personal",
        "file",
        "server",
        "http",
        "https",
        "media",
        "cloud",
        "storage",
        "self",
        "hosted"
    ],
    "bin": {
        "droppy": "bin/droppy.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/droppyjs/droppy.git"
    },
    "scripts": {
        "build:ts": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
        "start": "yarn build:ts && node ./dist/cli.js start",
        "build": "yarn build:ts && node ./dist/cli.js build"
    },
    "bugs": {
        "url": "https://github.com/droppyjs/droppy/issues"
    },
    "publishConfig": {
        "access": "public"
    }
}
