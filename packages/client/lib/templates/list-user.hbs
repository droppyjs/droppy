<ul class="list-user">
  {{#each users}}
  <li data-username="{{name}}">
    <div class="username">
      {{#if privileged}}
      {{{svg "user-cog"}}}
      {{else}}
      {{{svg "user"}}}
      {{/if}}
      {{name}}
    </div>
    <div class="delete-user tip tip-w" aria-label="Delete user">{{{svg "trash"}}}</div>
  </li>
  {{/each}}
  <li class="add-user tip tip-n" aria-label="To update a password add the user again">{{{svg "plus"}}}Add/Update a user
  </li>
</ul>