{
    "name": "@droppyjs/server",
    "version": "2.0.0-alpha.5",
    "description": "> Server for droppy.",
    "author": "droppyjs <hello@droppyjs.com>",
    "homepage": "https://github.com/droppyjs/droppy#readme",
    "license": "BSD-2-Clause",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "directories": {
        "lib": "lib",
        "src": "src",
        "test": "__tests__"
    },
    "exports": {
        ".": {
            "import": "./dist/index.js",
            "types": "./dist/index.d.ts"
        },
        "./services/db": {
            "import": "./dist/services/db/index.js",
            "types": "./dist/services/db/index.d.ts"
        },
        "./services/db/struct": {
            "import": "./dist/services/db/struct.js",
            "types": "./dist/services/db/struct.d.ts"
        },
        "./services/db/types": {
            "import": "./dist/services/db/types.js",
            "types": "./dist/services/db/types.d.ts"
        }
    },
    "files": [
        "dist"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/droppyjs/droppy.git"
    },
    "scripts": {
        "build:ts": "node ../../node_modules/typescript/bin/tsc -p tsconfig.json",
        "build": "yarn build:ts",
        "test": "echo \"Error: run tests from root\" && exit 1"
    },
    "bugs": {
        "url": "https://github.com/droppyjs/droppy/issues"
    },
    "dependencies": {
        "@droppyjs/client": "^2.0.0-alpha.3",
